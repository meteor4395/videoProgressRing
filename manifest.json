{
    "manifest_version": 3,
    "name": "Video Progress Ring",
    "version": "1.0.2",
    "description": "Shows playback progress in a circular overlay on playing videos.",
    "icons": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "Video Progress Ring",
      "default_icon": {
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png"
      }
    },
    "permissions": ["storage"],
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["content.css"],
        "all_frames": true,
        "run_at": "document_idle"
      }
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "video-progress-ring@example.com",
        "strict_min_version": "142.0",
        "data_collection_permissions": {
          "required": ["none"]
        }
      }
    }
  }